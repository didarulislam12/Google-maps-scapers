    {
      "parameters": {
        "jsCode": "const results = [...$('Search Google Maps page 1').all(), ...$input.all()];\nconst companies = [];\n\nresults.forEach(item => {\n  if (item.json.places) {\n    item.json.places.forEach(place => {\n      if (place.website) {\n      const company = {\n  name: place.title || '',\n  phone: place.phoneNumber || '',\n  website: place.website || '',\n  email: place.email || '',\n  linkedin: place.linkedin || '',\n  owner: place.owner || '',\n  address: place.address || '',\n  rating: place.rating || null,\n  ratingCount: place.ratingCount || null,\n  type: place.type || '',\n  latitude: place.latitude || null,\n  longitude: place.longitude || null\n};\n        \n        companies.push(company);\n      }\n    });\n  }\n});\n\nreturn companies.map(company => ({json: company}));"
      },
      "id": "187aa0a9-685b-42e5-bb22-b0638f20c84f",
